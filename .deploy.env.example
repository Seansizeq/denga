# Copy this file to `.deploy.env` and fill in real values.
# `.deploy.env` is gitignored and must never be committed.

# --- Production server (SSH) ---
DEPLOY_HOST=your.server.ip
DEPLOY_USER=root
# Either set DEPLOY_PASSWORD or DEPLOY_PRIVATE_KEY_PATH (preferred)
DEPLOY_PASSWORD=
DEPLOY_PRIVATE_KEY_PATH=

# Absolute path to the app on the server
DEPLOY_APP_DIR=/root/denga

# PM2 process name
DEPLOY_PM2_NAME=denga-app

# --- Git repo ---
# Public HTTPS URL works if repo is public.
# For private repos either configure a PAT on the server OR use an SSH deploy key.
GIT_REMOTE_URL=https://github.com/YourUser/YourRepo.git
GIT_BRANCH=main

# Optional: GitHub Personal Access Token used ONLY during server bootstrap
# to clone a private repo (stored as https://<user>:<token>@github.com/... in git credentials).
# Leave empty if the repo is public.
GITHUB_USER=
GITHUB_TOKEN=
