# Скопируйте в .env и заполните значения.
# Сервер подхватывает .env автоматически (см. dotenv в server/index.js).
# Для Vite переменные с префиксом VITE_ нужны при сборке фронта.

PORT=3001

# Telegram-бот (обязательно для npm run server)
TELEGRAM_BOT_TOKEN=

# Преміум-емодзі для компактного підтвердження транзакції в Telegram.
# Власник бота повинен мати Telegram Premium. Щоб отримати ID, надішліть
# боту 5 преміум-емодзі (витрата, дохід, зберегти, змінити, скасувати), а
# потім дайте відповідь на це повідомлення командою /emoji_ids.
# Без цих значень бот автоматично використовує звичайні емодзі.
# TELEGRAM_EMOJI_EXPENSE_ID=
# TELEGRAM_EMOJI_INCOME_ID=
# TELEGRAM_EMOJI_SAVE_ID=
# TELEGRAM_EMOJI_EDIT_ID=
# TELEGRAM_EMOJI_CANCEL_ID=

# --- Авторизация ---
# Без TELEGRAM_BOT_TOKEN подпись initData проверять нечем, поэтому сервер
# отказывается стартовать: ключ HMAC от пустой строки — публичная константа,
# и подпись стала бы подделываемой для любого user.id.

# Обход проверки initData для локальной разработки без Telegram.
# Работает ТОЛЬКО вместе с NODE_ENV=development. На сервере NODE_ENV не
# выставляется, поэтому забытый флаг там игнорируется с предупреждением в лог —
# забытая переменная должна вести к более строгому поведению, а не к дырке.
# NODE_ENV=development
# ALLOW_DEV_AUTH_BYPASS=1
# DEV_AUTH_USER_ID=dev-user

# Срок годности initData в секундах (по умолчанию 86400 — сутки).
# Telegram выдаёт строку один раз при запуске мини-приложения и больше не
# обновляет, так что слишком короткий срок будет рвать долгие сессии.
# TELEGRAM_INIT_DATA_MAX_AGE_SEC=86400

# Щоденний бекап БД: документ у цей чат (дізнатись id: @userinfobot)
# Година за часом **сервера** (0–23), див. `timedatectl` на VPS
# TELEGRAM_BACKUP_CHAT_ID=
# BACKUP_DAILY_HOUR=6

# Путь к файлу SQLite (по умолчанию database.sqlite в корне проекта)
# DATABASE_PATH=

# Если API на другом домене — укажите полный URL (иначе оставьте пустым)
# VITE_API_URL=

# OCR.space API key (для сканирования чеков, OCR).
# Бесплатная регистрация на https://ocr.space/ocrapi (25 000 запросов/мес).
# Если оставить пустым — будет использоваться публичный демо-ключ "helloworld" с очень
# жёсткими лимитами (несколько запросов в день на IP), только для проверки.
# OCR_SPACE_API_KEY=

# Умное добавление транзакций через бота (свободный текст: "купив каву 55").
# Google Gemini API key: https://aistudio.google.com/apikey
# Если пусто — бот работает как раньше (только числом + кнопки категорий).
# GEMINI_API_KEY=
# Модели перебираются по очереди: если одна упёрлась в лимит (429) —
# берётся следующая со свободной квотой. По умолчанию цепочка из flash/flash-lite
# моделей (gemini-3.1-flash-lite, gemini-2.5-flash-lite, ...).
# GEMINI_MODEL — предпочитаемая модель (ставится первой в цепочку).
# GEMINI_MODELS — полностью переопределить список (через запятую).
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash

# Какой провайдер разбирает текст. Незаданное значение = gemini, то есть
# поведение по умолчанию не менялось.
#   gemini — Google Gemini, нужен GEMINI_API_KEY (см. выше)
#   local  — любой OpenAI-совместимый сервер, нужен LOCAL_LLM_URL (см. ниже)
# Неизвестное имя НЕ откатывается к gemini, а выключает фичу: опечатка в
# `local` иначе тихо отправила бы текст ваших трат в Google — ровно туда,
# куда его отправлять и не хотели.
# SMART_TRANSACTION_PROVIDER=local

# --- Локальная модель (SMART_TRANSACTION_PROVIDER=local) ---
# Origin OpenAI-совместимого сервера: llama.cpp (llama-server), LM Studio,
# Ollama через /v1, vLLM. Путь /v1/chat/completions дописывается сам.
# LM Studio обычно слушает :1234; llama-server часто запускают на :8080.
# LOCAL_LLM_URL=http://127.0.0.1:1234
# LOCAL_LLM_API_KEY=denga-local
# Для LM Studio укажите точный id из GET /v1/models; для llama-server с одной
# загруженной моделью имя обычно не важно.
# LOCAL_LLM_MODEL=<model-id>
# Для reasoning-моделей LM Studio (например Qwen) режим none заметно ускоряет
# короткое извлечение и не даёт скрытым рассуждениям съесть весь лимит ответа.
# Если ваш OpenAI-совместимый сервер не знает это поле, оставьте его пустым.
# LOCAL_LLM_REASONING_EFFORT=none
# Локальная модель считает на своём железе, квоты нет — таймаут щедрее, чем
# у Gemini (15 с). Первый запрос после загрузки модели самый медленный.
# LOCAL_LLM_TIMEOUT_MS=60000

# --- Сеть и защита от флуда ---

# Разрешённые Origin для кросс-доменных запросов, через запятую.
# Свой же фронтенд сюда добавлять НЕ нужно: он отдаётся тем же Express,
# и запрос на собственный хост разрешается по совпадению Host, а не по списку.
# Пустое значение = никаких посторонних origin (раньше пустое означало «пускать
# всех» — незаданный параметр давал самое мягкое поведение).
# CORS_ORIGINS=https://example.com,https://admin.example.com

# За сколько прокси стоит приложение. 0 (по умолчанию) — не доверять
# X-Forwarded-For, req.ip = адрес сокета. Ставьте 1, только если nginx реально
# шлёт X-Forwarded-For (это делает актуальный setup_domain.js): иначе адрес
# будет диктовать сам клиент и лимит частоты обойдётся одной строкой в запросе.
# Без этого за nginx все клиенты видны как 127.0.0.1, и лимит по адресу
# становится общим потолком на всё приложение, а не на клиента.
# TRUST_PROXY=1

# Лимиты частоты, запросов в минуту.
# API_RATE_LIMIT_PER_MIN — грубый потолок на весь /api, считается по адресу
#   (до авторизации; см. TRUST_PROXY выше).
# USER_RATE_LIMIT_PER_MIN — персональный, считается по id пользователя.
# AUTOMATION_RATE_LIMIT_PER_MIN — на /api/automation, считается по токену
#   ярлыка, а запросы без токена — по адресу.
# API_RATE_LIMIT_PER_MIN=600
# USER_RATE_LIMIT_PER_MIN=300
# AUTOMATION_RATE_LIMIT_PER_MIN=60
