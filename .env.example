#Ключи и токены для работы бота и API. Не делитесь ими с другими людьми.
#ключ телеграм бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BACKUP_CHAT_ID=
# Куда отнести копию БД за пределы сервера. `{file}` заменяется на путь к копии.
# Нужно, когда база перерастает 45 МБ: больше этого Telegram файл от бота не примет,
# и без этой команды офсайт-копий не остаётся вовсе (бот пришлёт предупреждение).
# Пример: rclone copy {file} backup:denga/  ·  scp {file} user@host:/backups/
BACKUP_REMOTE_CMD=
#Порт, на котором будет работать сервер. Если не указан, будет выбран 3001.
PORT=
#URL для API, на который будет отправляться запросы. Если не указан, будет использоваться локальный сервер.
VITE_API_URL=
# Получи бесплатный ключ на https://ocr.space/ocrapi и вставь сюда.
OCR_SPACE_API_KEY=
ALLOW_PUBLIC_OCR_FALLBACK=
# Умное добавление транзакций через бота
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT_MS=
LOCAL_LLM_REASONING_EFFORT=
SMART_TRANSACTION_PROVIDER=
# API ключ для GEMINI
GEMINI_API_KEY=
# ОБЯЗАТЕЛЬНО 1, если приложение стоит за nginx (то есть на проде).
# Без этого req.ip у всех клиентов = 127.0.0.1, и лимит API_RATE_LIMIT_PER_MIN
# (600/мин) превращается из персонального в ОБЩИЙ потолок на всё приложение —
# это 10 запросов в секунду на всех. Проверено: один клиент выбирает его целиком.
# Включать только когда nginx действительно шлёт X-Forwarded-For (см. setup_domain.js),
# иначе адрес начинает диктовать сам клиент и лимит обходится одной строкой в запросе.
TRUST_PROXY=
# --- Роли процессов и наблюдаемость ---
# api | bot | all. По умолчанию all — один процесс делает всё (так работает
# разработка). На проде процессы разделены через ecosystem.config.cjs.
DENGA_ROLE=
# Сколько копий API работает рядом. Счётчики частоты живут в памяти процесса,
# поэтому каждая копия делит общую квоту на это число.
DENGA_API_INSTANCES=
# Токен для GET /metrics. Пока не задан, маршрут отвечает 404 — не 403:
# несуществующий путь не подсказывает, что тут есть что включать.
METRICS_TOKEN=
# Порт, на котором бот-процесс отдаёт /healthz и /metrics (только 127.0.0.1).
# У него нет своего HTTP, а посмотреть очередь Telegram и пул отрисовки надо.
BOT_HEALTH_PORT=
# --- Рассылка отчётов ---
# Сколько потоков рисует карточки. По умолчанию — ядра минус одно: одно
# остаётся процессам API, работающим рядом.
REPORT_RENDER_WORKERS=
# Как часто разборщик берёт отчёты из очереди, мс. По умолчанию 3000.
REPORT_DRAIN_TICK_MS=
# --- Дневные квоты на внешние сервисы ---
# Gemini и OCR.space считают лимит на ключ, а не на человека: несколько
# активных пользователей могут исчерпать его для всех остальных.
# 0 отключает функцию совсем. По умолчанию 50 и 20 в сутки на человека.
QUOTA_SMART_TRANSACTION_PER_DAY=
QUOTA_RECEIPT_SCAN_PER_DAY=