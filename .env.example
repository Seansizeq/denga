# Скопируйте в .env и заполните значения.
# Сервер подхватывает .env автоматически (см. dotenv в server/index.js).
# Для Vite переменные с префиксом VITE_ нужны при сборке фронта.

PORT=3001

# Telegram-бот (обязательно для npm run server)
TELEGRAM_BOT_TOKEN=

# --- Авторизация ---
# Без TELEGRAM_BOT_TOKEN подпись initData проверять нечем, поэтому сервер
# отказывается стартовать: ключ HMAC от пустой строки — публичная константа,
# и подпись стала бы подделываемой для любого user.id.

# Обход проверки initData для локальной разработки без Telegram.
# Работает ТОЛЬКО вместе с NODE_ENV=development. На сервере NODE_ENV не
# выставляется, поэтому забытый флаг там игнорируется с предупреждением в лог —
# забытая переменная должна вести к более строгому поведению, а не к дырке.
# NODE_ENV=development
# ALLOW_DEV_AUTH_BYPASS=1
# DEV_AUTH_USER_ID=dev-user

# Срок годности initData в секундах (по умолчанию 86400 — сутки).
# Telegram выдаёт строку один раз при запуске мини-приложения и больше не
# обновляет, так что слишком короткий срок будет рвать долгие сессии.
# TELEGRAM_INIT_DATA_MAX_AGE_SEC=86400

# Щоденний бекап БД: документ у цей чат (дізнатись id: @userinfobot)
# Година за часом **сервера** (0–23), див. `timedatectl` на VPS
# TELEGRAM_BACKUP_CHAT_ID=
# BACKUP_DAILY_HOUR=6

# Путь к файлу SQLite (по умолчанию database.sqlite в корне проекта)
# DATABASE_PATH=

# Если API на другом домене — укажите полный URL (иначе оставьте пустым)
# VITE_API_URL=

# OCR.space API key (для сканирования чеков, OCR).
# Бесплатная регистрация на https://ocr.space/ocrapi (25 000 запросов/мес).
# Если оставить пустым — будет использоваться публичный демо-ключ "helloworld" с очень
# жёсткими лимитами (несколько запросов в день на IP), только для проверки.
# OCR_SPACE_API_KEY=

# Умное добавление транзакций через бота (свободный текст: "купив каву 55").
# Google Gemini API key: https://aistudio.google.com/apikey
# Если пусто — бот работает как раньше (только числом + кнопки категорий).
# GEMINI_API_KEY=
# Модели перебираются по очереди: если одна упёрлась в лимит (429) —
# берётся следующая со свободной квотой. По умолчанию цепочка из flash/flash-lite
# моделей (gemini-3.1-flash-lite, gemini-2.5-flash-lite, ...).
# GEMINI_MODEL — предпочитаемая модель (ставится первой в цепочку).
# GEMINI_MODELS — полностью переопределить список (через запятую).
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash
